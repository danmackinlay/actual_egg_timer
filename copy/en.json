    "refusal.whiteNeverSets": { "surface": "body", "apps": ["web", "ios"], "text": "With the heat off this pan never sets the white: the water falls below what the white needs while the egg is still in it. Nothing on the slider is reachable. More water, a slower boil, or keep it boiling." },
    "refusal.harderThanPan": { "surface": "body", "apps": ["web", "ios"], "note": "{wanted} and {limit} are doneness words, lower-cased by the app.", "text": "With the heat off, the water runs out before the yolk gets there — {wanted} isn't reachable in {litres} L. Hardest here is {limit}. More water, or keep it boiling.", "example": { "wanted": "hard", "litres": "0.8", "limit": "fudgy" } },
    "refusal.counter": { "surface": "body", "apps": ["web", "ios"], "note": "{wanted} and {limit} are doneness words, lower-cased by the app.", "text": "Resting on the counter keeps cooking the yolk — {wanted} isn't reachable. Softest here is {limit}. Use an ice bath.", "example": { "wanted": "runny", "limit": "fudgy" } },
    "refusal.tap": { "surface": "body", "apps": ["web", "ios"], "note": "{wanted} and {limit} are doneness words, lower-cased by the app.", "text": "A cold tap doesn't pull the heat out fast enough — {wanted} isn't reachable. Softest here is {limit}. Ice water gets you further.", "example": { "wanted": "runny", "limit": "soft" } },
    "refusal.ice": { "surface": "body", "apps": ["web", "ios"], "note": "{wanted} and {limit} are doneness words, lower-cased by the app.", "text": "Any shorter and the white is still raw — {wanted} isn't reachable for this egg. Softest here is {limit}.", "example": { "wanted": "runny", "limit": "soft" } },

