@article{vega2011culinary,
  author  = {Vega, C{\'e}sar and Mercad{\'e}-Prieto, Ruben},
  title   = {Culinary Biophysics: on the Nature of the 6{X}$^\circ${C} Egg},
  journal = {Food Biophysics},
  volume  = {6},
  pages   = {152--159},
  year    = {2011},
  doi     = {10.1007/s11483-010-9200-1},
  note    = {Source of Z_YOLK. Rheology of yolk gelation at constant temperature,
             54-70 C: Ea = 469 +/- 13 kJ/mol from isothermal gelation time and
             483 +/- 37 from the viscosity-rise slope, so z = 4.65 K at 338 K is
             interpolation rather than extrapolation. Publishes the absolute
             Arrhenius fit, which read at 63 C gives a yolk gel point of 67
             equivalent minutes -- the one doneness anchor here that comes from a
             measurement. NB the printed equation has its exponent sign
             transposed; use t_gel = 8.85e-72 exp(469e3/RT) minutes, which
             reproduces their figure 4. Concludes there is no such thing as a
             63 C egg: texture is time AND temperature. Also records that fitting
             a conduction-only model to a 6X C cook needs alpha > 2e-7, because
             the unset white convects}
}

@article{weijers2003ovalbumin,
  author  = {Weijers, M. and Barneveld, P. A. and Cohen Stuart, M. A. and
             Visschers, R. W.},
  title   = {Heat-induced denaturation and aggregation of ovalbumin at neutral
             {pH} described by irreversible first-order kinetics},
  journal = {Protein Science},
  volume  = {12},
  pages   = {2693--2703},
  year    = {2003},
  doi     = {10.1110/ps.03242803},
  note    = {Free at PMC2366979 (Wiley blocks robots). Ea about 480 kJ/mol, with
             430-490 across techniques. This corrected Z_WHITE from 5.2 to
             4.97 K: an earlier draft of this model assumed 460 kJ/mol}
}

@incollection{powrie1985eggs,
