@misc{lorig2026softboiled,
  author       = {Lorig, Matthew},
  title        = {How to Cook a Soft-Boiled Egg Optimally: {A} {L}aplace-Transform
                  Solution of a Two-Domain Heat Equation},
  howpublished = {arXiv:2606.22156},
  year         = {2026},
  doi          = {10.48550/arXiv.2606.22156},
  note         = {The closest published two-domain treatment, and the method is
                  sound. CHECK EVERY PARAMETER BEFORE ADOPTING IT: Table 1 gives
                  a 1.1 cm yolk radius credited to Abbasnezhad, who says 1.6 cm,
