% actual_egg_timer — further reading.
%
% Everything the model rests on, plus the things worth reading next. The `note`
% field on each entry says what it is actually good for and whether it was read
% at first hand; README.md section 10 carries the same list in prose, and
% section 11 says which questions each one settled.
%
% Access notes matter here because the first build of this model recorded the
% primary literature as unreachable. It is not: the free copies are named.

% ---------------------------------------------------------------------------
% Heat transfer in eggs
% ---------------------------------------------------------------------------

@misc{williams1998egg,
  author       = {Williams, Charles D. H.},
  title        = {The Science of Boiling an Egg},
  howpublished = {University of Exeter, Physics and Astronomy},
  year         = {1998},
  url          = {https://newton.ex.ac.uk/teaching/CDHW/egg/},
  note         = {Originally a letter to \emph{New Scientist}, ``The Last Word'',
                  4 April 1998. Source of the one-term formula, its 0.76
                  coefficient, and the soft-boiled criterion of 63 C at the yolk
                  boundary. Gives no hard-boiled target: the 70 C on the page is
                  the greening threshold. Stated properties rho = 1.038 g/cm^3,
                  c = 3.7 J/g/K, K = 5.4e-3 W/cm/K reproduce his published 0.451
                  prefactor. The host is dead; read it via the Internet Archive}
}

@article{buay2006egg,
  author  = {Buay, D. and Foong, S. K. and Kiang, D. and Kuppan, L. and Liew, V. H.},
  title   = {How long does it take to boil an egg? {R}evisited},
  journal = {European Journal of Physics},
  volume  = {27},
  number  = {1},
  pages   = {119--131},
  year    = {2006},
  doi     = {10.1088/0143-0807/27/1/013},
  note    = {The most useful single source for this model. Type-K thermocouple at
             the centre of a real egg (semi-axes 27.11 x 21.22 mm) in a stirred
             100.5 C bath: centre reaches 85 C at 750 s measured, 745 s
             predicted. Fits a whole-egg alpha = 1.6e-7 m^2/s, bounded 1.5-1.8e-7.
             Determines the hard-boiled criterion experimentally as 85 C at the
             yolk CENTRE. States explicitly that Williams' 0.76 belongs to the
             yolk boundary and their coefficient 2 to the yolk centre. Uses the
             surface-to-volume equivalent radius 2ab/(b + beta a), not the
             equal-volume radius. No cooling data}
}

@article{roura2000egg,
  author  = {Roura, P. and Fort, J. and Saurina, J.},
  title   = {How long does it take to boil an egg? {A} simple approach to the
             energy transfer equation},
  journal = {European Journal of Physics},
  volume  = {21},
  number  = {1},
  pages   = {95--100},
  year    = {2000},
  url     = {https://copernic.udg.edu/QuimFort/EJP_00.pdf},
  note    = {Free PDF at the URL. A scaling argument rather than a solution:
             thermalisation when the Fourier modulus approaches unity. Takes
             70 C as the cooking temperature, measured by heating egg in a test
             tube. Reports their own measurement alpha_white = 1.5 alpha_water
             and alpha_yolk = 1.1 alpha_water, i.e. 2.3e-7 and 1.7e-7 m^2/s --
             higher than everyone else's, and not used here}
}

@article{abbasnezhad2016egg,
  author  = {Abbasnezhad, Behzad and Hamdami, Nasser and Monteau, Jean-Yves and
             Vatankhah, Hamed},
  title   = {Numerical modeling of heat transfer and pasteurizing value during
             thermal processing of intact egg},
  journal = {Food Science \& Nutrition},
  volume  = {4},
  number  = {1},
  pages   = {42--49},
  year    = {2016},
  doi     = {10.1002/fsn3.257},
  note    = {Free at PMC4708634 (Wiley blocks robots). Settles the albumen
             diffusivity question: k_white = 0.0013 T + 0.5125, rho_white =
             -0.0041 T^2 - 0.0115 T + 1043.3, c_p = 3800, giving alpha rising
             1.36e-7 at 20 C to 1.69e-7 at 100 C. Yolk k = 0.0008 T + 0.395.
             Shell 2.25 W/mK, credited to Denys. Meshes the yolk as a sphere of
             radius 1.6 cm inside a 6 x 4.5 cm egg. Contains nothing resembling
             the impossible 0.026 W/mK sometimes attributed to it}
}

@article{denys2004cfd,
  author  = {Denys, Siegfried and Pieters, Jan G. and Dewettinck, Koen},
  title   = {Computational fluid dynamics analysis of combined conductive and
             convective heat transfer in model eggs},
  journal = {Journal of Food Engineering},
  volume  = {63},
  number  = {3},
  pages   = {281--290},
  year    = {2004},
  doi     = {10.1016/j.jfoodeng.2003.06.002},
  note    = {Buoyancy-driven flow in liquid albumen (Ra 1e6-1e7) measurably
             speeds heating and moves the cold spot off-centre and downwards;
             the yolk, being layered, stays conduction-only. Measured eggshell
             thickness 0.35-0.5 mm. Yolk properties k = 0.337 W/mK, c_p = 3560,
             rho = 1035 from Romanoff and Romanoff. Quotes the measured surface
             coefficient h = 490 W/m^2K from Denys et al. (2003)}
}

@article{denys2003surface,
