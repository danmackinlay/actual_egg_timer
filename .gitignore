# macOS and editors
.DS_Store

# Xcode per-user state and archives
xcuserdata/
*.xcuserstate
*.ipa
*.dSYM
*.dSYM.zip

# Swift Package Manager
.swiftpm/

# The shape study's runs, made again by tools/shape-study/RESULTS.md's commands
tools/shape-study/results*.json

# Build output
dist/
node_modules/
_site/
.netlify/

# Swift package build products
.build/
ios/build/
ios/build-device/

# Generated by `cd ios && xcodegen` from ios/project.yml, which is the source of
# truth. The widget's Info.plist is generated rather than written by the build
# system because NSExtension is a nested dictionary and INFOPLIST_KEY_* settings
# can only express flat values.
ios/ActualEggTimer.xcodeproj/
ios/Widget/Info.plist
# Written by xcodegen for CFBundleLocalizations, the one array the app's plist
# needs; every other key is generated by the build from project.yml.
ios/App/Info.plist

# The fit's data: shared eggs pulled from the store, simulated cooks, and the
# emulated tables built from either (tools/eggs.ts). People's eggs never go
# into git; the rest is regenerated in a minute.
fit/data/
fit/.venv/
__pycache__/
.pytest_cache/

# The owner's trusted random IDs for the fit (DECISIONS.md 82): never in git,
# since an ID here would tie the owner to their results. fit/trusted.example.txt
# shows the shape.
fit/trusted.local.txt
