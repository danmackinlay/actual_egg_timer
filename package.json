{
  "name": "actual-egg-timer",
  "version": "0.5.0-alpha.1",
  "description": "Actual Egg Timer: a boiled-egg timer that computes the time from transient conduction and denaturation kinetics",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.app.json && tsc -p tsconfig.json",
    "test": "npm run typecheck && node --test test/*.test.ts",
    "test:slow": "AET_TEST_SLOW=1 node --test test/*.test.ts",
    "validate": "node tools/validate.ts",
    "fixtures": "node tools/fixtures.ts",
    "population": "node tools/population.ts",
    "eggs": "node tools/eggs.ts",
    "identifiability": "node studies/identifiability.ts",
    "rank": "node studies/rank.ts",
    "probe": "node studies/probe.ts",
    "decide": "node studies/decide.ts",
    "posterior": "node tools/posterior.ts",
    "sbc": "node tools/posterior.ts sbc",
    "sounds": "node tools/sounds.ts",
    "copy:literals": "node tools/copyLiterals.ts",
    "copy:keys": "node tools/copyKeys.ts",
    "copy:snapshot": "npm run build:site && node tools/copySnapshot.ts",
    "copy:queue": "node tools/copyQueue.ts queue",
    "copy:approve": "node tools/copyQueue.ts approve",
    "copy:review": "node tools/copyReview.ts",
    "fixtures:check": "npm run fixtures && node tools/fixturesCheck.ts",
    "conformance": "npm run fixtures:check && cd ios/EggTimerCore && swift test",
    "verify": "node tools/verify.mjs",
    "ios:archive": "node tools/iosArchive.mjs",
    "ios:upload": "node tools/iosUpload.mjs",
    "ios:e2e": "node tools/iosE2e.ts",
    "ios:release": "node tools/iosArchive.mjs && node tools/iosUpload.mjs",
    "ios:build": "cd ios && xcodegen --quiet && xcodebuild -project ActualEggTimer.xcodeproj -scheme ActualEggTimer -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO -quiet build && xcodebuild -project ActualEggTimer.xcodeproj -scheme ActualEggTimer -configuration Release -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO -quiet build",
    "build:site": "node tools/buildSite.mjs",
    "serve:site": "python3 -m http.server 8080 --directory _site",
    "serve:dev": "npm run build:site && node tools/devServer.ts",
    "e2e": "npm run build:site && node tools/e2e.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.1",
    "cborg": "6.1.3"
  }
}
