// The studies: measurements quoted in the documents, run by hand, never
// by a gate, and outside the default build (`npm run build`), so a change
// to core or the tools need not carry them. Each study's npm script builds
// this project first, over core and the tools: `node tools/build.mjs
// studies`.
{
  "extends": "../tsconfig.base.json",
  "include": ["*.ts"],
  "references": [{ "path": "../tsconfig.json" }]
}
