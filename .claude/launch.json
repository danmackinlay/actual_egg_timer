{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "egg-timer",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "npm run build:site && python3 -m http.server \"${PORT:-8080}\" --directory _site"],
      "port": 8080,
      "autoPort": true
    },
    {
      "name": "egg-lab",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "npm run build && python3 -m http.server \"${PORT:-8391}\""],
      "port": 8391,
      "autoPort": true
    }
  ]
}
