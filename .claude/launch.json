{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "egg-timer",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npm run build:site && python3 -m http.server \"${PORT:-8080}\" --directory _site"
      ],
      "port": 8080,
      "autoPort": true
    },
    {
      "name": "egg-timer-dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npm run build:site && node tools/devServer.ts"
      ],
      "port": 8888,
      "autoPort": true
    },
    {
      "name": "egg-lab",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npm run build:site && PORT=\"${PORT:-8391}\" node tools/devServer.ts"
      ],
      "port": 8391,
      "autoPort": true
    }
  ]
}
